{
  "name": "@fiscus/source",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "libs/*",
    "modules/*/*",
    "tools/*"
  ],
  "scripts": {
    "check": "biome check .",
    "format": "biome check --write .",
    "boundaries": "node tools/boundaries/check-boundaries.mjs",
    "boundaries:test": "node --test \"tools/boundaries/*.test.mjs\"",
    "secrets": "bun tools/secrets/check-secrets.mjs",
    "secrets:test": "node --test \"tools/secrets/*.test.mjs\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@nx/devkit": "23.2.1",
    "@nx/esbuild": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/vite": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@swc/core": "1.15.8",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "jsdom": "30.1.1",
    "nx": "23.2.1",
    "typescript": "~6.0.3",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  },
  "trustedDependencies": [
    "@swc/core"
  ]
}
