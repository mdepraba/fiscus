# Copy to .env for local development. Bun loads it when it runs the API
# (`bun x nx run @app/api:serve`), and the database tests load it through
# Vitest. compose.yaml serves this database: docker compose up -d postgres
DATABASE_URL=postgres://fiscus:fiscus@localhost:5432/fiscus

# FR-01: the API binds to loopback, because only `tailscale serve` reaches it.
HOST=127.0.0.1
PORT=3000

# --- Production -------------------------------------------------------------
# The host keeps its own /srv/fiscus/.env, owned by root with mode 0600
# (NFR-10). systemd reads it as the unit's EnvironmentFile, so every line is a
# plain KEY=VALUE with no quotes, spaces or shell expansion.
#
# Required:
#DATABASE_URL=postgres://fiscus:PASSWORD@127.0.0.1:5432/fiscus
#
# Leave HOST and PORT unset there: the defaults, 127.0.0.1 and 3000, are where
# `tailscale serve` and the deploy's health check look.
